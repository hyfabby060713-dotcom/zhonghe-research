# Leave all three empty for local demo. Use the public publishable/anon key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TEAM_ID=
# history for standard Netlify deployments; hash for anonymous static previews.
VITE_ROUTER_MODE=history
# GitHub Pages workflow sets this automatically from the repository URL.
VITE_BASE_PATH=/
